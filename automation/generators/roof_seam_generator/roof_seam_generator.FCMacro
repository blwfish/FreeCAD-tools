"""
Roof Seam Generator for FreeCAD v1.2.1
Generates hip cap shingles or valley flashing between two selected roof faces.

Author: Brian (with Claude assistance)
Usage: Ctrl+click two adjacent roof faces, run as macro in FreeCAD

Version History:
- 1.2.1: Fix rotation handedness bug in hip cap halves. When d is sign-flipped
         to point toward the face interior, {d, edge_dir, n} becomes left-handed,
         producing a reflection that flips one half 180°. Now computes Z axis as
         d.cross(edge_dir) (always right-handed) and offsets the corner by
         mat_thick along n when Z points inward.
- 1.2.0: Redesign hip cap geometry. Each cap position now produces two
         half-shingles, one per face, each lying flat on its slope and
         meeting at the shared edge. The previous single flat box floated
         above the roof surface on any seam with a significant slope angle.
- 1.1.2: Fix face-matching metric in closest_base_face(). Centroid-to-centroid
         distance was picking eave/soffit faces instead of slope faces for
         shingles near the hip seam. Now uses distToShape() (point-to-surface
         distance): the shingle's centroid lies on the slope surface it was
         generated from, so surface dist ≈ 0 for the correct face and >> 0
         for all others.
- 1.1.1: Fix wrong-seam selection when both ShingledRoof compounds share the
         same BaseObject (e.g. two slopes of the same roof solid). The old
         brute-force search over all BaseObject face pairs found the first
         shared edge in the solid rather than the one near the selected
         shingles. Now uses centroid proximity to map each selected shingle
         face to its closest BaseObject roof-plane face, then checks only
         that specific pair.
- 1.1.0: Auto-unwrap ShingledRoof compounds via BaseObject so the macro works
         when the user clicks on individual shingle faces rather than the
         original roof faces. resolve_shared_edge() tries raw faces first,
         then falls back to all BaseObject-face pairs.
- 1.0.2: Add face vertex/edge diagnostic dump to "no shared edge" error.
- 1.0.1: Replace sys.exit() with if/else (FreeCAD macro best practice).
         Add raw selection dump to the "wrong face count" error so the cause
         (e.g. selection cleared by Macros dialog, or whole-object selected
         instead of face sub-elements) is immediately visible in the log.
- 1.0.0: Initial release.
         Auto-detects hip vs valley from Z coordinates:
           Hip/ridge: non-shared vertices are BELOW the shared edge
                      → cap shingles at exposure intervals straddling the edge
           Valley: non-shared vertices are ABOVE the shared edge
                   → single flat flashing strip along full edge length

         IMPORTANT: Uses * operator (not .multiply()) for all vector scaling
         because App.Vector.multiply() mutates the vector in place.

Parameters read from spreadsheet (falls back to defaults if not found):
    shingleWidth          — used as default for hipCapWidth
    shingleHeight         — height of each hip cap shingle
    materialThickness     — thickness of cap/flashing; default for valleyFlashingWidth
    shingleExposure       — spacing between hip cap shingles
    hipCapWidth           — width of hip cap (default: shingleWidth)
    valleyFlashingWidth   — width of valley flashing (default: materialThickness * 8)

Output:
    HipCap_{objectName}          — compound of cap shingles (hip/ridge)
    ValleyFlashing_{objectName}  — compound of flashing strip (valley)
"""

import FreeCAD as App
import FreeCADGui as Gui
import Part
from FreeCAD import Vector
import math
import sys

VERSION = "1.2.1"
GENERATOR_NAME = "roof_seam_generator"


# ============================================================================
# Spreadsheet parameter loading
# ============================================================================

def find_spreadsheet(doc):
    """Find spreadsheet by name or label, following App::Link if needed."""
    preferred_names = ["params", "ShingleParameters", "BuildingParameters", "Spreadsheet"]
    for ss_name in preferred_names:
        obj = doc.getObject(ss_name)
        if obj:
            if obj.TypeId == 'App::Link':
                target = obj.LinkedObject
                if target and target.TypeId == 'Spreadsheet::Sheet':
                    return target
            elif obj.TypeId == 'Spreadsheet::Sheet':
                return obj
        for obj in doc.Objects:
            if obj.Label == ss_name:
                if obj.TypeId == 'App::Link':
                    target = obj.LinkedObject
                    if target and target.TypeId == 'Spreadsheet::Sheet':
                        return target
                elif obj.TypeId == 'Spreadsheet::Sheet':
                    return obj
    return None


def get_params_from_spreadsheet(doc):
    """Read seam generator parameters from spreadsheet. Returns {} if not found."""
    ss = find_spreadsheet(doc)
    if ss is None:
        return {}

    params = {}
    aliases = {
        'shingleWidth':         ['shingleWidth'],
        'shingleHeight':        ['shingleHeight'],
        'materialThickness':    ['materialThickness'],
        'shingleExposure':      ['shingleExposure', 'exposure'],
        'hipCapWidth':          ['hipCapWidth'],
        'valleyFlashingWidth':  ['valleyFlashingWidth'],
    }

    for key, names in aliases.items():
        for name in names:
            try:
                val = ss.get(name)
                if val is not None:
                    params[key] = float(val)
                    break
            except Exception:
                continue

    return params


# ============================================================================
# Geometry helpers
# ============================================================================

def find_shared_edge(face1, face2, tol=0.01):
    """Find the shared edge between two faces by matching endpoint positions."""
    for e1 in face1.Edges:
        p1a = e1.Vertexes[0].Point
        p1b = e1.Vertexes[-1].Point
        for e2 in face2.Edges:
            p2a = e2.Vertexes[0].Point
            p2b = e2.Vertexes[-1].Point
            if ((p1a.distanceToPoint(p2a) < tol and p1b.distanceToPoint(p2b) < tol) or
                    (p1a.distanceToPoint(p2b) < tol and p1b.distanceToPoint(p2a) < tol)):
                return e1
    return None


def classify_seam(face1, face2, shared_edge):
    """
    Classify the shared edge as 'hip' or 'valley' using Z-coordinate analysis.

    Valley: non-shared vertices are ABOVE the shared edge
            (they're at the eaves; the shared edge is the valley bottom)
    Hip:    non-shared vertices are BELOW the shared edge
            (they're at the eaves; the shared edge is the hip peak or ridge)
    """
    edge_verts = [v.Point for v in shared_edge.Vertexes]
    edge_max_z = max(p.z for p in edge_verts)

    # Build set of positions that lie on the shared edge (rounded for tolerance)
    shared_pts = set()
    for p in edge_verts:
        shared_pts.add((round(p.x, 2), round(p.y, 2), round(p.z, 2)))

    non_shared_z = []
    for face in (face1, face2):
        for v in face.Vertexes:
            key = (round(v.Point.x, 2), round(v.Point.y, 2), round(v.Point.z, 2))
            if key not in shared_pts:
                non_shared_z.append(v.Point.z)

    if not non_shared_z:
        App.Console.PrintMessage("  WARNING: Could not find non-shared vertices, defaulting to hip\n")
        return 'hip'

    avg_z = sum(non_shared_z) / len(non_shared_z)

    App.Console.PrintMessage(f"  Shared edge max Z:      {edge_max_z:.3f} mm\n")
    App.Console.PrintMessage(f"  Non-shared vertices avg Z: {avg_z:.3f} mm\n")

    if avg_z > edge_max_z:
        return 'valley'
    else:
        return 'hip'


def closest_base_face(orig_face, base_faces):
    """
    Return the face in base_faces whose SURFACE is closest to orig_face's
    centroid point.

    The shingle was extruded from the roof slope, so its centroid lies
    essentially on (or very near) that slope's surface — surface distance
    ≈ 0.  Centroid-to-centroid distance is unreliable because a small
    shingle near an edge can be much farther from the slope-face centre than
    from the centre of an adjacent eave/soffit face.
    """
    orig_center = orig_face.CenterOfMass
    test_vtx = Part.Vertex(orig_center)
    best = None
    best_dist = float('inf')
    for f in base_faces:
        try:
            d = f.distToShape(test_vtx)[0]
        except Exception:
            # Fall back to centroid distance if distToShape fails
            d = orig_center.distanceToPoint(f.CenterOfMass)
        if d < best_dist:
            best_dist = d
            best = f
    App.Console.PrintMessage(f"    → best base face surface dist: {best_dist:.4f} mm\n")
    return best


def resolve_shared_edge(face1, obj1, face2, obj2):
    """
    Find the shared edge between two faces, automatically unwrapping
    ShingledRoof compounds to their BaseObject faces when needed.

    When the user clicks on shingles (not on the original roof geometry),
    the selected faces are individual shingle-box faces from a ShingledRoof
    compound.  Those shingles don't share edges with each other.  But the
    compound has a BaseObject property pointing to the original roof shape
    whose faces DO share the hip/valley edge.

    Strategy:
      1. Try the raw selected faces (fast path — works if user selected from
         the original roof geometry).
      2. If either object is a ShingledRoof compound, find the single
         BaseObject face closest (by centroid) to each selected shingle face,
         then check just that pair.  Proximity correctly maps each shingle to
         the roof plane it sits on — avoiding the wrong-edge problem that
         occurs when brute-forcing all face pairs of the same base solid.

    Returns:
        (shared_edge, resolved_face1, resolved_obj1, resolved_face2, resolved_obj2)
        or (None, face1, obj1, face2, obj2) if no shared edge found.
    """
    # Fast path: raw faces share an edge directly
    edge = find_shared_edge(face1, face2)
    if edge is not None:
        return edge, face1, obj1, face2, obj2

    # Unwrap each compound to its single best-matching BaseObject face
    def get_base(face, obj):
        if (obj.TypeId == 'Part::Compound'
                and hasattr(obj, 'BaseObject')
                and obj.BaseObject is not None):
            base = obj.BaseObject
            App.Console.PrintMessage(
                f"  Unwrapping {obj.Name} → BaseObject={base.Name}"
                f" ({len(base.Shape.Faces)} face(s))\n"
            )
            return closest_base_face(face, base.Shape.Faces), base
        return face, obj

    f1, o1 = get_base(face1, obj1)
    f2, o2 = get_base(face2, obj2)

    if f1 is not face1 or f2 is not face2:
        edge = find_shared_edge(f1, f2)
        if edge is not None:
            App.Console.PrintMessage("  Found shared edge via BaseObject resolution\n")
            return edge, f1, o1, f2, o2

    return None, face1, obj1, face2, obj2


def face_normal_at_center(face):
    """Return the face normal at its parametric center."""
    uv = face.ParameterRange
    u_mid = (uv[0] + uv[1]) / 2.0
    v_mid = (uv[2] + uv[3]) / 2.0
    return face.normalAt(u_mid, v_mid)


def make_rotation_matrix(x_axis, y_axis, z_axis):
    """
    Build a rotation matrix from three orthogonal basis vectors (column convention).
    Box local X → x_axis, local Y → y_axis, local Z → z_axis.
    """
    return App.Matrix(
        x_axis.x, y_axis.x, z_axis.x, 0,
        x_axis.y, y_axis.y, z_axis.y, 0,
        x_axis.z, y_axis.z, z_axis.z, 0,
        0, 0, 0, 1
    )


# ============================================================================
# Cap shingle generation (hip / ridge)
# ============================================================================

def generate_hip_caps(shared_edge, face1, face2, params):
    """
    Generate cap shingles straddling the hip/ridge edge.

    Each cap position produces TWO half-shingles that each lie flat on their
    respective face and meet at the shared edge.  This avoids the "floating
    flat slab" problem that occurs when a single rectangular box is placed in
    the bisector plane of a steep diagonal hip seam.

    Coordinate system per half (guaranteed right-handed):
      X = d  — away from seam toward face interior (sign-corrected)
      Y = edge_dir — along the shared edge
      Z = d × edge_dir — perpendicular to X and Y

    When d is sign-flipped (to point toward the face interior), Z may end up
    pointing inward (−n) instead of outward (+n).  In that case the box
    corner is offset outward by materialThickness so the box still sits on
    top of the face surface.
    """
    cap_width    = params.get('hipCapWidth', params.get('shingleWidth', 3.5))
    cap_height   = params.get('shingleHeight', 2.0)
    mat_thick    = params.get('materialThickness', 0.25)
    exposure     = params.get('shingleExposure', 1.5)
    half_width   = cap_width / 2.0

    App.Console.PrintMessage(
        f"Hip cap: width={cap_width:.2f}  height={cap_height:.2f}  "
        f"thickness={mat_thick:.2f}  exposure={exposure:.2f}\n"
    )

    # Edge geometry
    start_pt   = shared_edge.Vertexes[0].Point
    end_pt     = shared_edge.Vertexes[-1].Point
    edge_vec   = end_pt - start_pt
    edge_len   = edge_vec.Length
    edge_dir   = edge_vec * (1.0 / edge_len)

    # Face normals (outward from roof surface)
    n1 = face_normal_at_center(face1)
    n2 = face_normal_at_center(face2)

    seam_mid = (start_pt + end_pt) * 0.5

    def half_cap_setup(n, face_centroid):
        """
        Compute rotation and corner offset for one half-cap.

        Returns (rotation, z_outward) where z_outward is True if the box
        sits naturally on the surface (corner at seam point) or False if
        the corner must be offset by mat_thick along n.
        """
        # d: perpendicular to edge, in face plane
        d_raw = n.cross(edge_dir)
        d     = d_raw * (1.0 / d_raw.Length)

        # Sign-correct d to point toward face interior
        if (face_centroid - seam_mid).dot(d) < 0:
            d = d * -1.0

        # Z = d × edge_dir — guaranteed right-handed with X=d, Y=edge_dir
        z = d.cross(edge_dir)
        z = z * (1.0 / z.Length)

        outward = z.dot(n) >= 0

        App.Console.PrintMessage(
            f"    d=({d.x:.3f},{d.y:.3f},{d.z:.3f})  "
            f"z=({z.x:.3f},{z.y:.3f},{z.z:.3f})  outward={outward}\n"
        )

        rot = App.Rotation(make_rotation_matrix(d, edge_dir, z))
        return rot, outward, n

    App.Console.PrintMessage(
        f"  edge_dir: ({edge_dir.x:.3f}, {edge_dir.y:.3f}, {edge_dir.z:.3f})\n"
        f"  n1:       ({n1.x:.3f}, {n1.y:.3f}, {n1.z:.3f})\n"
        f"  n2:       ({n2.x:.3f}, {n2.y:.3f}, {n2.z:.3f})\n"
    )

    App.Console.PrintMessage("  Face 1 half:\n")
    rot1, outward1, _ = half_cap_setup(n1, face1.CenterOfMass)
    App.Console.PrintMessage("  Face 2 half:\n")
    rot2, outward2, _ = half_cap_setup(n2, face2.CenterOfMass)

    shapes = []
    t = 0.0
    while t < edge_len:
        pt = start_pt + edge_dir * t

        # Face1 half
        h1 = Part.makeBox(half_width, cap_height, mat_thick)
        corner1 = pt if outward1 else pt + n1 * mat_thick
        h1.Placement = App.Placement(corner1, rot1)

        # Face2 half
        h2 = Part.makeBox(half_width, cap_height, mat_thick)
        corner2 = pt if outward2 else pt + n2 * mat_thick
        h2.Placement = App.Placement(corner2, rot2)

        shapes.extend([h1, h2])
        t += exposure

    App.Console.PrintMessage(f"  Generated {len(shapes)//2} hip cap pairs ({len(shapes)} pieces)\n")
    return shapes


# ============================================================================
# Valley flashing generation
# ============================================================================

def generate_valley_flashing(shared_edge, face1, face2, params):
    """
    Generate a single flat flashing strip along the valley edge.

    The strip:
      - Spans valleyFlashingWidth centered on the edge (half on each face)
      - Runs the full length of the shared edge
      - Thickness extends outward along the bisector of the two face normals
    """
    mat_thick      = params.get('materialThickness', 0.25)
    flash_width    = params.get('valleyFlashingWidth', mat_thick * 8.0)

    App.Console.PrintMessage(
        f"Valley flashing: width={flash_width:.2f}  thickness={mat_thick:.2f}\n"
    )

    # Edge geometry
    start_pt   = shared_edge.Vertexes[0].Point
    end_pt     = shared_edge.Vertexes[-1].Point
    edge_vec   = end_pt - start_pt
    edge_len   = edge_vec.Length
    edge_dir   = edge_vec * (1.0 / edge_len)

    # Face normals → bisector
    n1 = face_normal_at_center(face1)
    n2 = face_normal_at_center(face2)
    bisector_raw = n1 + n2
    bisector     = bisector_raw * (1.0 / bisector_raw.Length)

    # Width direction
    wd_raw    = edge_dir.cross(bisector)
    width_dir = wd_raw * (1.0 / wd_raw.Length)

    # Corner: centered on edge in width direction, starts at edge start
    corner = start_pt - width_dir * (flash_width / 2.0)

    # Rotation: box X → width_dir, box Y → edge_dir, box Z → bisector
    rotation = App.Rotation(make_rotation_matrix(width_dir, edge_dir, bisector))

    strip = Part.makeBox(flash_width, edge_len, mat_thick)
    strip.Placement = App.Placement(corner, rotation)

    App.Console.PrintMessage(
        f"  Generated flashing strip ({flash_width:.2f} x {edge_len:.2f} x {mat_thick:.2f} mm)\n"
    )
    return [strip]


# ============================================================================
# Main execution
# ============================================================================

if __name__ == "__main__":

    doc = App.ActiveDocument
    if not doc:
        App.Console.PrintError("ERROR: No active document\n")
    else:
        App.Console.PrintMessage(f"\n{'='*60}\n")
        App.Console.PrintMessage(f"Roof Seam Generator v{VERSION}\n")
        App.Console.PrintMessage(f"{'='*60}\n\n")

        # --- Load parameters ---
        defaults = {
            'shingleWidth':       3.5,
            'shingleHeight':      2.0,
            'materialThickness':  0.25,
            'shingleExposure':    1.5,
            # hipCapWidth:        defaults to shingleWidth inside generate_hip_caps
            # valleyFlashingWidth: defaults to materialThickness * 8 inside generate_valley_flashing
        }
        sheet_params = get_params_from_spreadsheet(doc)
        params = {**defaults, **sheet_params}

        App.Console.PrintMessage("Parameters:\n")
        for k, v in sorted(params.items()):
            src = "(spreadsheet)" if k in sheet_params else "(default)"
            App.Console.PrintMessage(f"  {k}: {v} {src}\n")
        App.Console.PrintMessage("\n")

        # --- Validate exposure vs height ---
        if params.get('shingleExposure', 0) > params.get('shingleHeight', float('inf')):
            App.Console.PrintError(
                f"ERROR: shingleExposure ({params['shingleExposure']}) "
                f"cannot exceed shingleHeight ({params['shingleHeight']})\n\n"
            )

        else:
            # --- Get selected faces ---
            selection = Gui.Selection.getSelectionEx()
            selected_faces = []
            for sel in selection:
                if not sel.HasSubObjects:
                    continue
                for sub in sel.SubElementNames:
                    if sub.startswith("Face"):
                        idx  = int(sub[4:]) - 1
                        face = sel.Object.Shape.Faces[idx]
                        selected_faces.append((face, sel.Object))

            if len(selected_faces) != 2:
                App.Console.PrintError(
                    f"ERROR: Select exactly 2 adjacent roof faces (got {len(selected_faces)})\n\n"
                )
                # Dump raw selection state to help diagnose the cause
                App.Console.PrintMessage(f"Raw selection ({len(selection)} item(s)):\n")
                if not selection:
                    App.Console.PrintMessage(
                        "  (empty — selection was cleared before macro ran;\n"
                        "   run via toolbar button, not the Macros… dialog)\n"
                    )
                for sel in selection:
                    App.Console.PrintMessage(
                        f"  obj={sel.Object.Name}  HasSubObjects={sel.HasSubObjects}"
                        f"  SubElementNames={sel.SubElementNames}\n"
                    )
                App.Console.PrintMessage("\nUsage:\n")
                App.Console.PrintMessage("  1. Ctrl+click two adjacent roof faces in the 3D view\n")
                App.Console.PrintMessage("  2. Run via toolbar button (not Macros… dialog)\n\n")

            else:
                face1, obj1 = selected_faces[0]
                face2, obj2 = selected_faces[1]

                # --- Find shared edge (with automatic ShingledRoof unwrapping) ---
                App.Console.PrintMessage("Finding shared edge...\n")
                shared_edge, face1, obj1, face2, obj2 = resolve_shared_edge(
                    face1, obj1, face2, obj2
                )

                if shared_edge is None:
                    App.Console.PrintError(
                        "ERROR: No shared edge found between the two selected faces"
                        " (or their BaseObjects).\n"
                        "Make sure you select two adjacent roof faces that share an edge.\n\n"
                    )

                else:
                    App.Console.PrintMessage(f"  Found shared edge, length = {shared_edge.Length:.2f} mm\n")

                    # --- Classify seam type ---
                    seam_type = classify_seam(face1, face2, shared_edge)
                    App.Console.PrintMessage(f"  Seam type: {seam_type.upper()}\n\n")

                    # --- Generate geometry ---
                    base_name = obj1.Name

                    if seam_type == 'hip':
                        shapes = generate_hip_caps(shared_edge, face1, face2, params)
                        output_name = f"HipCap_{base_name}"
                    else:
                        shapes = generate_valley_flashing(shared_edge, face1, face2, params)
                        output_name = f"ValleyFlashing_{base_name}"

                    if not shapes:
                        App.Console.PrintError("ERROR: No geometry generated.\n")

                    else:
                        # --- Create output Part::Feature ---
                        compound = Part.Compound(shapes)
                        result = doc.addObject("Part::Feature", output_name)
                        result.Shape = compound

                        result.addProperty("App::PropertyString", "GeneratorName",    "Metadata", "Generator name")
                        result.GeneratorName    = GENERATOR_NAME

                        result.addProperty("App::PropertyString", "GeneratorVersion", "Metadata", "Generator version")
                        result.GeneratorVersion = VERSION

                        result.addProperty("App::PropertyString", "SeamType",         "Metadata", "Seam type (hip or valley)")
                        result.SeamType         = seam_type

                        doc.recompute()

                        App.Console.PrintMessage(f"\n{'='*60}\n")
                        App.Console.PrintMessage(f"SUCCESS: Created '{output_name}' ({len(shapes)} piece(s))\n")
                        App.Console.PrintMessage(f"{'='*60}\n\n")
